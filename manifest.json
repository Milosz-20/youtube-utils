{
  "manifest_version": 3,
  "name": "YouTube Utils",
  "version": "1.5.0",
  "description": "YouTube tweaks: Shorts filter, count-in, metronome and A-B loop for practice, Songsterr tabs next to the video, SponsorBlock, quality and speed controls.",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-utils@milosz-20",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "optional_permissions": ["userScripts"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://www.songsterr.com/*",
    "https://dqsljvtekg760.cloudfront.net/*",
    "https://d3d3l6a6rcgkaf.cloudfront.net/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Utils",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "options/options.html?popup=1"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["tabs/player.html"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": [
        "core/runtime.js",
        "modules/shorts-subs-only.js",
        "modules/shorts-lock-player.js",
        "modules/playback-speed.js",
        "modules/default-quality.js",
        "modules/sponsorblock.js",
        "modules/count-in.js",
        "modules/tab-player.js",
        "modules/block-shortcuts-help.js",
        "core/boot.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
